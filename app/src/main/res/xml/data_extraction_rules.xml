<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or transfer the encrypted DX NET credentials. Their Keystore key
     cannot leave the device, so a restored copy would be undecryptable anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dx-net-auto-login.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dx-net-auto-login.xml" />
    </device-transfer>
</data-extraction-rules>
