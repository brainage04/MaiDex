<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window shown before Compose draws when Android uses its dark theme; the app's own
         Light/Dark/System setting takes over once MaiDexTheme is composed. -->
    <style name="Theme.MaiDex" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#101417</item>
        <item name="android:navigationBarColor">#101417</item>
        <item name="android:statusBarColor">#101417</item>
    </style>
</resources>
